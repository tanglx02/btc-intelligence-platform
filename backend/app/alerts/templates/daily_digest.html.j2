{# 每日摘要邮件 HTML 模板。
   变量：platform_name, generated_at, price{current,change_24h,change_7d},
        engines{cycle_phase,valuation_level,risk_level,overall_regime},
        indicators[{label,value,percentile,signal}], etf{last_net_flow,net_flow_7d},
        changes_24h[{label,text}], watch_rules[{rule_name,condition_text,status}],
        platform_url #}
{% set chg24 = price.change_24h %}{% set chg7 = price.change_7d %}
<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="utf-8"></head>
<body style="margin:0;padding:0;background:#f4f5f7;font-family:'PingFang SC','Microsoft YaHei',Helvetica,Arial,sans-serif;">
<div style="max-width:640px;margin:24px auto;background:#ffffff;border:1px solid #e5e7eb;border-radius:14px;overflow:hidden;">
  <div style="background:linear-gradient(135deg,#111827,#1f2937);padding:22px 28px;">
    <div style="font-size:12px;letter-spacing:2px;color:#9ca3af;">BTC INTELLIGENCE PLATFORM</div>
    <div style="margin-top:6px;font-size:19px;font-weight:700;color:#f9fafb;">每日市场摘要</div>
    <div style="margin-top:4px;font-size:12px;color:#9ca3af;">{{ generated_at }}</div>
  </div>

  <div style="padding:24px 28px;">
    <!-- 价格 -->
    <table width="100%" cellpadding="0" cellspacing="0"><tr>
      <td style="background:#f9fafb;border-radius:10px;padding:14px 16px;">
        <div style="font-size:12px;color:#6b7280;">BTC 当前价格</div>
        <div style="font-size:26px;font-weight:800;color:#111827;">{{ price.current or "—" }}</div>
        <div style="font-size:13px;margin-top:2px;">
          {% if chg24 is not none %}<span style="color:{{ '#dc2626' if chg24 < 0 else '#16a34a' }};font-weight:600;">24H {{ "%+.2f"|format(chg24) }}%</span>{% endif %}
          {% if chg7 is not none %}<span style="color:{{ '#dc2626' if chg7 < 0 else '#16a34a' }};font-weight:600;margin-left:12px;">7D {{ "%+.2f"|format(chg7) }}%</span>{% endif %}
        </div>
      </td>
    </tr></table>

    <!-- 9 大维度状态 -->
    <h3 style="margin:22px 0 8px;font-size:14px;color:#111827;">综合状态</h3>
    <table width="100%" cellpadding="0" cellspacing="0" style="font-size:13px;">
      <tr>
        <td style="width:50%;padding:8px 12px;background:#f9fafb;border-radius:8px 0 0 0;color:#6b7280;">市场阶段<br><b style="color:#111827;">{{ engines.cycle_phase or "—" }}</b></td>
        <td style="width:50%;padding:8px 12px;background:#f9fafb;border-radius:0 8px 0 0;color:#6b7280;">估值状态<br><b style="color:#111827;">{{ engines.valuation_level or "—" }}</b></td>
      </tr>
      <tr>
        <td style="padding:8px 12px;background:#f9fafb;border-radius:0 0 0 8px;color:#6b7280;">风险等级<br><b style="color:#111827;">{{ engines.risk_level or "—" }}</b></td>
        <td style="padding:8px 12px;background:#f9fafb;border-radius:0 0 8px 0;color:#6b7280;">综合状态<br><b style="color:#111827;">{{ engines.overall_regime or "—" }}</b></td>
      </tr>
    </table>

    <!-- 关键指标 -->
    {% if indicators %}
    <h3 style="margin:22px 0 8px;font-size:14px;color:#111827;">关键指标</h3>
    <table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e5e7eb;font-size:13px;">
      <tr style="background:#f9fafb;color:#6b7280;">
        <th align="left" style="padding:8px 12px;">指标</th>
        <th align="right" style="padding:8px 12px;">当前值</th>
        <th align="right" style="padding:8px 12px;">历史分位</th>
        <th align="right" style="padding:8px 12px;">信号</th>
      </tr>
      {% for m in indicators %}
      <tr style="border-top:1px solid #f3f4f6;color:#111827;">
        <td style="padding:8px 12px;">{{ m.label }}</td>
        <td align="right" style="padding:8px 12px;font-weight:700;">{{ m.value }}</td>
        <td align="right" style="padding:8px 12px;color:#6b7280;">{{ m.percentile }}</td>
        <td align="right" style="padding:8px 12px;color:#6b7280;">{{ m.signal or "—" }}</td>
      </tr>
      {% endfor %}
    </table>
    {% endif %}

    <!-- ETF 资金流 -->
    {% if etf and (etf.last_net_flow or etf.net_flow_7d) %}
    <h3 style="margin:22px 0 8px;font-size:14px;color:#111827;">ETF 资金流</h3>
    <div style="padding:10px 14px;background:#f9fafb;border-radius:8px;font-size:13px;color:#374151;">
      最新交易日净流入：<b style="color:{{ '#16a34a' if (etf.last_net_flow or 0) >= 0 else '#dc2626' }};">{{ etf.last_net_flow or "—" }}</b><br>
      近 7 日净流入合计：<b style="color:{{ '#16a34a' if (etf.net_flow_7d or 0) >= 0 else '#dc2626' }};">{{ etf.net_flow_7d or "—" }}</b>
    </div>
    {% endif %}

    <!-- 过去 24h 重要变化 -->
    {% if changes_24h %}
    <h3 style="margin:22px 0 8px;font-size:14px;color:#111827;">过去 24 小时重要变化</h3>
    <ul style="margin:0;padding-left:18px;font-size:13px;color:#374151;line-height:1.9;">
      {% for ch in changes_24h %}<li><b>{{ ch.label }}</b>：{{ ch.text }}</li>{% endfor %}
    </ul>
    {% endif %}

    <!-- 需关注的条件 -->
    {% if watch_rules %}
    <h3 style="margin:22px 0 8px;font-size:14px;color:#111827;">需关注的监测条件</h3>
    <table width="100%" cellpadding="0" cellspacing="0" style="font-size:13px;">
      {% for r in watch_rules %}
      <tr>
        <td style="padding:8px 12px;background:#fffbeb;border-radius:8px;color:#374151;">
          <b>{{ r.rule_name }}</b>　<span style="color:#92400e;">{{ r.status }}</span><br>
          <span style="color:#6b7280;">{{ r.condition_text }}</span>
        </td>
      </tr>
      {% endfor %}
    </table>
    {% endif %}

    <p style="margin:22px 0 0;padding-top:14px;border-top:1px dashed #e5e7eb;font-size:12px;color:#9ca3af;line-height:1.6;">
      免责声明：本摘要仅为数据汇总，不构成任何投资建议。
    </p>
  </div>

  <div style="padding:16px 28px;background:#f9fafb;border-top:1px solid #e5e7eb;text-align:center;">
    <a href="{{ platform_url }}" style="display:inline-block;padding:10px 28px;background:#111827;color:#ffffff;border-radius:8px;text-decoration:none;font-size:14px;font-weight:600;">打开平台</a>
    <div style="margin-top:10px;font-size:11px;color:#9ca3af;">{{ platform_name }} · 本邮件由系统自动发送</div>
  </div>
</div>
</body>
</html>
