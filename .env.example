# ==========================================================
# BTC 全市场智能研究平台 - 环境变量模板
# 复制为 .env 后按需填写；.env 已被 .gitignore 忽略，切勿提交
# ==========================================================

# ---------- 应用基础配置 ----------
# 运行环境: development / staging / production
APP_ENV=development
# 是否开启调试模式（true 时日志级别为 DEBUG）
DEBUG=true
# API 路由前缀
API_V1_PREFIX=/api/v1
# 后端服务监听地址与端口
HOST=0.0.0.0
PORT=8000

# ---------- CORS ----------
# 逗号分隔来源列表（生产经 nginx 同源反代，通常无需修改）
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------- 安全 / 鉴权 ----------
# JWT 签名密钥，生产环境务必替换为高强度随机值
# 生成: openssl rand -hex 32
SECRET_KEY=change-me-in-production
# 访问令牌过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 签名算法
ALGORITHM=HS256

# ---------- 数据库 (PostgreSQL + TimescaleDB) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=btc_platform
POSTGRES_USER=btc_admin
POSTGRES_PASSWORD=changeme

# ---------- 缓存 (Redis) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_DB=0

# ---------- 外部数据源 API Keys（按需填写，未使用的留空）----------
# 行情数据
PROVIDER_BINANCE_KEY=
PROVIDER_COINBASE_KEY=
# 衍生品 / 资金费率 / 未平仓合约
PROVIDER_COINGLASS_KEY=
# 链上数据
PROVIDER_GLASSNODE_KEY=
PROVIDER_CRYPTOQUANT_KEY=
# ETF 资金流
PROVIDER_FARSIDE_KEY=
# 期权数据
PROVIDER_DERIBIT_KEY=
# 宏观经济数据
PROVIDER_FRED_KEY=
# 市场情绪（恐惧贪婪指数）
PROVIDER_ALTERNATIVE_KEY=

# ---------- 调度器 ----------
# 是否启用定时任务调度
SCHEDULER_ENABLED=true
# 调度时区
SCHEDULER_TIMEZONE=Asia/Shanghai

# ---------- SMTP 邮件通知 ----------
# 是否启用邮件发送（false 时预警仍记录事件但不投递）
SMTP_ENABLED=false
# SMTP 服务器地址与端口（587=STARTTLS，465=隐式 SSL）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 发件人地址与显示名
SMTP_FROM_EMAIL=alerts@btc-platform.local
SMTP_FROM_NAME=BTC Intelligence Platform
# TLS 模式：USE_TLS=STARTTLS（配合 587）；USE_SSL=隐式 SSL（配合 465）
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ---------- Alert 引擎 ----------
# 是否启用预警引擎
ALERT_ENABLED=true
# 扫描间隔（秒）
ALERT_SCAN_INTERVAL_SECONDS=60
# 默认收件人（MVP 单收件人）
ALERT_DEFAULT_RECIPIENT=
# 默认冷却秒数
ALERT_COOLDOWN_DEFAULT_SECONDS=3600
# 用户级每小时最多触发条数
ALERT_MAX_PER_HOUR=20

# ---------- 平台入口（邮件「查看详情」链接）----------
PLATFORM_URL=http://localhost:3000

# ---------- 部署与运维（供 scripts/backup.sh 使用，非后端 config 字段）----------
# 备份加密密钥（留空时 .env 备份为明文 + 600 权限）
# 生成: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=

# ---------- 网络代理（可选，供后端抓取境外数据源使用）----------
# 留空表示直连；填入后由 httpx 自动读取（trust_env）
HTTP_PROXY=
HTTPS_PROXY=
# 本地/容器间互联不走代理
NO_PROXY=localhost,127.0.0.1,postgres,redis,backend,frontend
